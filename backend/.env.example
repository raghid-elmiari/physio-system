# Copy to backend/.env and adjust. Spring Boot loads this file automatically
# (spring.config.import in application.yml); real environment variables take precedence.
# Never commit backend/.env.

# --- Database -------------------------------------------------------------
# Option A (default): MySQL 8. The database is created automatically if the user may do so.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=physio_assistant
DB_USER=physio_app
DB_PASSWORD=change-me

# Option B: zero-install H2 file database (./data/physio.mv.db). Uncomment to use instead of MySQL.
# SPRING_PROFILES_ACTIVE=h2

# Option C (production): Supabase PostgreSQL. Use the "Session pooler" values from
# Supabase → Project → Connect. Set these on the hosting platform, never in frontend code.
# SPRING_PROFILES_ACTIVE=postgres
# DB_HOST=aws-0-<region>.pooler.supabase.com
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres.<project-ref>
# DB_PASSWORD=<database password>

# --- Auth -----------------------------------------------------------------
# Must be at least 32 bytes. Generate one with:  openssl rand -base64 48
# The value below is for local development only; the server logs a warning while it is in use.
JWT_SECRET=dev-only-insecure-secret-replace-me-with-openssl-rand-base64-48
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=14

# --- CORS -----------------------------------------------------------------
# Comma-separated list of allowed frontend origins (Vite dev, Vite preview, Capacitor).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,capacitor://localhost,http://localhost,https://localhost

# --- Demo data (local development only) -----------------------------------
# Creates therapist@demo.local and patient@demo.local (with an assigned exercise) on startup.
SEED_DEMO_DATA=true
DEMO_USER_PASSWORD=Demo12345

# --- Optional legacy Python AI service (edge-device flow only) ------------
AI_SERVICE_URL=http://localhost:5001
