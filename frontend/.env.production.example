# Production values for the Vercel build (set them in Vercel → Project → Settings →
# Environment Variables; Vite bakes them into the bundle at build time).
# Only public values belong here: never put database or Supabase service keys in VITE_* variables.

# Public URL of the deployed Spring Boot API, including /api
VITE_API_BASE_URL=https://your-backend.onrender.com/api
VITE_POSE_MODEL=lite
VITE_TARGET_FPS=30
