# Copy to frontend/.env (optional: these are the defaults).
# Base URL of the Spring Boot API. For a phone on your Wi-Fi use your computer's LAN IP,
# e.g. https://192.168.1.20:8080/api (the phone's camera requires HTTPS, see README).
VITE_API_BASE_URL=http://localhost:8080/api

# Pose model: "lite" (fastest, recommended for phones) or "full" (more accurate, slower).
VITE_POSE_MODEL=lite

# Upper bound for frames analysed per second; the app lowers it automatically on slow devices.
VITE_TARGET_FPS=30
